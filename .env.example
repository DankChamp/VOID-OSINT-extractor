# video-intel environment template
#
# Copy to `.env` and fill in only the providers you actually intend to use.
# `.env` is git-ignored. video-intel reads these variables at call time; the values
# are never written to configuration files, project data or logs.
#
# Export them before running, e.g.:  set -a && source .env && set +a

# ---------------------------------------------------------------- cloud providers
# Transcript text is sent to a provider only when a pipeline is explicitly bound to
# it. With execution_mode=local_only the application refuses cloud providers outright.

OPENAI_API_KEY=replace-with-your-openai-key
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
GROQ_API_KEY=replace-with-your-groq-key
GEMINI_API_KEY=replace-with-your-gemini-key

# ------------------------------------------------------------------ local provider
# OLLAMA host for local models. Local inference needs no key.
OLLAMA_HOST=http://127.0.0.1:11434

# ------------------------------------------------------------ operational settings
# Optional; shown here for reference. Precedence: defaults < user config < project
# config < these variables < CLI flags.

# VIDEO_INTEL_DATA_DIR=/home/you/data/video-intel
# VIDEO_INTEL_PROJECT_NAME=default
# VIDEO_INTEL_EXECUTION_MODE=local_only
# VIDEO_INTEL_LOG_LEVEL=INFO
# VIDEO_INTEL_LOG_FORMAT=text
# VIDEO_INTEL_MAX_EXTRACTION_PASSES=2

# ---------------------------------------------------------------- caption retrieval
# Only needed when YouTube blocks direct access from this network. Leave unset for
# direct access.
# HTTPS_PROXY=http://127.0.0.1:8080
